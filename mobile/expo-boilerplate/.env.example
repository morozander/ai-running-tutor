# Only EXPO_PUBLIC_-prefixed vars are inlined into the app bundle by Expo.
# Full GraphQL/API endpoint URL (backend serves GraphQL at /api/v1).
# Also read by `pnpm codegen` to introspect the schema — same contract as frontend's VITE_APP_API_URL.
EXPO_PUBLIC_API_URL="http://localhost:3001/api/v1"
EXPO_PUBLIC_AWS_USER_POOL_ID=""
EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT=""
