# Application
NODE_ENV=development
PORT=3001

# CORS: comma-separated explicit origin allowlist, e.g.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
# When empty, any origin is allowed WITHOUT credentials — credentialed
# (cookie-based) browser clients require an explicit allowlist.
CORS_ORIGIN=

# Database (PostgreSQL)
RDS_DATABASE_HOST=db
RDS_DATABASE_PORT=5432
RDS_DATABASE_USERNAME=postgres
RDS_DATABASE_PASSWORD=postgres
RDS_DATABASE_NAME=app_database

# AWS Cognito Auth
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional: Only needed if your app client has a client secret
COGNITO_CLIENT_SECRET=

# Cognito Webhook (for Lambda triggers)
# Shared secret to authenticate webhook calls from Cognito Lambda triggers.
# Verification fails CLOSED when unset — requests are rejected.
WEBHOOK_SECRET=
# EXPLICIT local-dev opt-in to skip webhook secret verification.
# Ignored when NODE_ENV=production. Never enable outside local development.
WEBHOOK_ALLOW_UNVERIFIED=false

# AWS General
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS SQS
SQS_QUEUE_NAME=
SQS_QUEUE_URL=
SQS_DLQ_NAME=
SQS_DLQ_URL=
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_RECEIVE_COUNT=3
SQS_MESSAGE_RETENTION_PERIOD=1209600

# AWS S3 (File Storage)
S3_BUCKET=
S3_MAX_FILE_SIZE_MB=10

# AWS Bedrock (AI)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Logging
LOG_LEVEL=debug

# OpenTelemetry (works in Lambda, ECS, local)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nestjs-app
OTEL_SERVICE_VERSION=1.0.0
# OTLP endpoint (Jaeger, Tempo, AWS X-Ray collector, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Or separate endpoints for traces and metrics:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_SAMPLE_RATE=1.0
OTEL_HOST_METRICS=false

# SendGrid(service for sending e-mail)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=your.test@gmail.com
SENDGRID_FROM_NAME=


#DB VARS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_database
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=

