{
  "name": "nestjs-lambda-boilerplate",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "description": "High-performance, Lambda-ready NestJS boilerplate with MikroORM and GraphQL",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate:create": "mikro-orm migration:create",
    "db:migrate:up": "mikro-orm migration:up",
    "db:migrate:down": "mikro-orm migration:down",
    "db:migrate:fresh": "mikro-orm migration:fresh",
    "db:migrate:pr": "node scripts/create-pr-schema.js && mikro-orm migration:up",
    "db:schema:drop-pr": "node scripts/drop-pr-schema.js",
    "db:schema:update": "mikro-orm schema:update --run",
    "db:seed": "mikro-orm seeder:run",
    "prepare": "lefthook install",
    "create:domain": "ts-node scripts/generate-domain.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-sqs": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@mikro-orm/core": "^6.6.14",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "^6.6.14",
    "@nestjs/apollo": "^13.4.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/platform-express": "^11.1.19",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sendgrid/helpers": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.33",
    "@types/aws-lambda": "^8.10.161",
    "aws-lambda": "^1.0.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7",
    "nestjs-otel": "^8.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@mikro-orm/cli": "^6.6.14",
    "@mikro-orm/seeder": "^6.6.14",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "lefthook": "^2.1.6",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "ajv": ">=8.18.0",
      "bn.js": ">=5.2.3",
      "minimatch": ">=10.2.1",
      "fast-xml-parser": ">=5.3.6",
      "systeminformation": ">=5.31.0"
    }
  }
}
